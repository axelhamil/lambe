{
  "threshold": 3,
  "reporters": ["console"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.output/**",
    "**/.wxt/**",
    "**/*.d.ts",
    "**/*.test.ts"
  ],
  "format": ["typescript", "javascript", "tsx", "jsx"],
  "minLines": 10,
  "minTokens": 70,
  "absolute": true
}
