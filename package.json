{
  "name": "lambe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Translate web pages and YouTube captions in place with the model you choose, local first.",
  "license": "MIT",
  "author": "axelhamil",
  "homepage": "https://github.com/axelhamil/lambe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axelhamil/lambe.git"
  },
  "bugs": {
    "url": "https://github.com/axelhamil/lambe/issues"
  },
  "scripts": {
    "check": "biome check .",
    "fix": "biome check --write .",
    "type-check": "pnpm -r --if-present run type-check",
    "test": "pnpm -r --workspace-concurrency=1 --if-present run test",
    "check:unused": "knip",
    "check:duplication": "jscpd ./packages ./apps",
    "check:boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "zip": "pnpm --filter @lambe/extension zip",
    "verify": "pnpm check && pnpm type-check && pnpm test && pnpm check:unused && pnpm check:duplication && pnpm check:boundaries",
    "prepare": "husky"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "dependency-cruiser": "18.7.0",
    "husky": "9.1.7",
    "jscpd": "5.4.2",
    "knip": "6.42.1",
    "typescript": "7.0.2"
  }
}
