{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "apps/extension": {
      "entry": ["entrypoints/*.ts", "entrypoints/*/main.tsx", "scripts/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "entrypoints/**/*.{ts,tsx}", "scripts/**/*.ts"],
      "ignoreIssues": {
        "src/options/components/ui/**": ["exports", "types"]
      }
    }
  },
  "ignoreWorkspaces": ["packages/typescript-config"],
  "ignoreExportsUsedInFile": true
}
