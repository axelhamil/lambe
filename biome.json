{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": true,
  "plugins": [
    {
      "path": "./tooling/biome-plugins/no-empty-validate.grit",
      "includes": ["**/packages/translation/src/domain/**"]
    },
    {
      "path": "./tooling/biome-plugins/no-foreign-props-access.grit",
      "includes": ["**/packages/translation/src/domain/**", "!**/*.test.ts"]
    }
  ],
  "files": {
    "includes": [
      "**",
      "!.claude",
      "!.superpowers",
      "!docs/mockups",
      "!assets",
      "!packages/translation/fixtures"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUndeclaredVariables": "error",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noDoubleEquals": "error",
        "noImportCycles": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "error",
        "useExportType": "error",
        "useConst": "error",
        "useTemplate": "error",
        "noParameterAssign": "error",
        "noUselessElse": "error",
        "noInferrableTypes": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        }
      },
      "performance": {
        "noBarrelFile": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "overrides": [
    {
      "includes": ["apps/extension/src/**", "apps/extension/entrypoints/**"],
      "javascript": {
        "globals": ["chrome"]
      }
    },
    {
      "includes": ["apps/extension/scripts/**"],
      "javascript": {
        "globals": ["Bun"]
      }
    }
  ]
}
